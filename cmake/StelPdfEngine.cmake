set(STEL_PDF_ROOT "" CACHE PATH "MuPDF renderer prefix (scripts/build-pdf-engine.py)")
find_path(STEL_MUPDF_INCLUDE mupdf/fitz.h HINTS "${STEL_PDF_ROOT}/include" REQUIRED)
find_library(STEL_MUPDF_LIBRARY NAMES mupdf libmupdf HINTS "${STEL_PDF_ROOT}/lib" REQUIRED)
find_library(STEL_MUPDF_THIRD_LIBRARY NAMES mupdf-third libthirdparty HINTS "${STEL_PDF_ROOT}/lib" REQUIRED)
add_library(stel_pdf INTERFACE)
target_include_directories(stel_pdf INTERFACE "${STEL_MUPDF_INCLUDE}")
target_link_libraries(stel_pdf INTERFACE "${STEL_MUPDF_LIBRARY}" "${STEL_MUPDF_THIRD_LIBRARY}")
if(WIN32)
  foreach(name libresources libharfbuzz libpkcs7 libextract libtesseract libmubarcode)
    find_library(STEL_PDF_${name} NAMES ${name} HINTS "${STEL_PDF_ROOT}/lib" REQUIRED)
    target_link_libraries(stel_pdf INTERFACE "${STEL_PDF_${name}}")
  endforeach()
  target_link_libraries(stel_pdf INTERFACE crypt32 bcrypt ws2_32 user32 gdi32 advapi32)
else()
  find_package(Threads REQUIRED)
  target_link_libraries(stel_pdf INTERFACE m Threads::Threads ${CMAKE_DL_LIBS})
  if(NOT APPLE)
    # Keep the embedded renderer's font/image libraries private; Qt continues
    # to use its own compatible HarfBuzz/FreeType/libpng implementations.
    target_link_options(stel_pdf INTERFACE "LINKER:--exclude-libs,libmupdf.a:libmupdf-third.a")
  endif()
endif()
