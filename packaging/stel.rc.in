// Explorer version and icon metadata; generated from CMake's project version.
#include <windows.h>
#define IDI_STEL 101
IDI_STEL ICON "stel.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Mehrdad Seifzadeh\0"
   VALUE "FileDescription", "Stel SIP softphone\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "Stel\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Mehrdad Seifzadeh. GPL-3.0-or-later.\0"
   VALUE "OriginalFilename", "stel.exe\0"
   VALUE "ProductName", "Stel\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
