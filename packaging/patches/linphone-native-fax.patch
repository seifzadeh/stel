+// Belle-SDP 5.3 represents media formats as RTP integers. Normalize only the
+// non-RTP T.38 format at the serialization boundary, preserving all SDP fields.
+static std::string stelT38Sdp(const std::string &input, bool wire) {
+    std::istringstream lines(input); std::string line, result;
+    while (std::getline(lines, line)) {
+        std::istringstream fields(line); std::string type, port, proto, format;
+        fields >> type >> port >> proto >> format;
+        if (type == "m=image" && (proto == "udptl" || proto == "UDPTL") &&
+            format == (wire ? "0" : "t38")) {
+            line = type + " " + port + " udptl " + (wire ? "t38" : "0") + "\r";
+        }
+        result += line + "\n";
+    }
+    return result;
+}
