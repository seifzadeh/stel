+// Stel's opt-in external T.38 media endpoint. UDPTL has no RTP payload types.
+static bool stelT38(const SalStreamDescription &s) {
+    return s.type == SalOther && s.typeother == "image" && (s.getProtoAsString() == "udptl" || s.getProtoAsString() == "UDPTL");
+}
+static SalStreamDescription stelT38Result(const SalStreamDescription &local,
+                                         const SalStreamDescription &remote, bool incoming) {
+    SalStreamDescription result(incoming ? local : remote);
+    result.rtp_port = local.enabled() && remote.enabled() ? result.rtp_port : 0;
+    return result;
+}
